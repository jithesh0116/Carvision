SECRET_KEY=774f9782dd1fe334877cefb2ee87dcfcb49450db50d7d9c2ccc9517487a4ef8c
FLASK_DEBUG=0

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=carvision_db

# Uploads
MAX_UPLOAD_MB=8python -c "import secrets; print(secrets.token_hex(32))"
REQUIRE_IMAGE=true

# Image recognition: minimum softmax probability before "AI detected" is shown.
# This is a display threshold you can tune; it is not a model metric.
CNN_CONFIDENCE_THRESHOLD=0.60

# Currency shown in the UI. Must match the currency of your dataset's price column.
CURRENCY_SYMBOL=₹
CURRENCY_LOCALE=en-IN
# Displayed prices are rounded to this step (presentation only). Use 1 for no rounding.
PRICE_ROUNDING=1000
